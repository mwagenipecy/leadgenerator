APP_NAME="Fanikisha"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Optional override for storage URLs (defaults to APP_URL/storage)
FILESYSTEM_PUBLIC_URL=
 
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
 
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
 
PHP_CLI_SERVER_WORKERS=4
 
BCRYPT_ROUNDS=12
 
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
 
DB_CONNECTION=sqlite
# PostgreSQL (use with Docker / production):
# DB_CONNECTION=pgsql
# DB_HOST=postgres   <- use "postgres" (Docker service name), not 127.0.0.1
# DB_HOST=127.0.0.1  <- only for local dev outside Docker
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=laravel
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
 
